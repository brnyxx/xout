[
{"text": "- Ask for approval before you change any code.", "lang": "en", "expect": ["autonomy", "ask_first"]},
{"text": "Check with me before editing files - no exceptions.", "lang": "en", "expect": ["autonomy", "ask_first"]},
{"text": "Do not proceed without my explicit sign-off.", "lang": "en", "expect": ["autonomy", "ask_first"]},
{"text": "코드를 고치기 전에 계획을 보여 주고 승인을 받는다.", "lang": "ko", "expect": ["autonomy", "ask_first"]},
{"text": "파일을 수정하기 전에 먼저 물어본다.", "lang": "ko", "expect": ["autonomy", "ask_first"]},
{"text": "허락 없이 작업을 시작하지 마라.", "lang": "ko", "expect": ["autonomy", "ask_first"]},
{"text": "コードに手を入れる前に承認を得ること。", "lang": "ja", "expect": ["autonomy", "ask_first"]},
{"text": "作業を始める前に必ず確認を取る。", "lang": "ja", "expect": ["autonomy", "ask_first"]},
{"text": "改代码之前先征得我同意。", "lang": "zh", "expect": ["autonomy", "ask_first"]},
{"text": "动手之前先问一下我。", "lang": "zh", "expect": ["autonomy", "ask_first"]},

{"text": "Write a short plan first, then implement it.", "lang": "en", "expect": ["autonomy", "propose_then_act"]},
{"text": "Outline the approach first, then go ahead without waiting.", "lang": "en", "expect": ["autonomy", "propose_then_act"]},
{"text": "짧은 계획을 먼저 적고 곧바로 진행한다.", "lang": "ko", "expect": ["autonomy", "propose_then_act"]},
{"text": "작업 방향을 먼저 정리한 뒤 이어서 구현한다.", "lang": "ko", "expect": ["autonomy", "propose_then_act"]},
{"text": "先に短い計画を書いてから実装に入る。", "lang": "ja", "expect": ["autonomy", "propose_then_act"]},
{"text": "方針をまとめてから実装を進める。", "lang": "ja", "expect": ["autonomy", "propose_then_act"]},
{"text": "先写一个简短的方案，然后直接实现。", "lang": "zh", "expect": ["autonomy", "propose_then_act"]},
{"text": "先说清楚思路，再动手改。", "lang": "zh", "expect": ["autonomy", "propose_then_act"]},

{"text": "Act first, then report what changed.", "lang": "en", "expect": ["autonomy", "act_then_report"]},
{"text": "Never ask before acting - just summarize afterwards.", "lang": "en", "expect": ["autonomy", "act_then_report"], "note": "negation flip"},
{"text": "Go ahead without asking and tell me when it's done.", "lang": "en", "expect": ["autonomy", "act_then_report"], "note": "negation flip"},
{"text": "먼저 실행하고 나중에 변경 내역을 보고한다.", "lang": "ko", "expect": ["autonomy", "act_then_report"]},
{"text": "묻지 말고 바로 진행한 뒤 결과만 알려줘.", "lang": "ko", "expect": ["autonomy", "act_then_report"], "note": "negation flip"},
{"text": "승인 기다리지 말고 바로 고쳐라.", "lang": "ko", "expect": ["autonomy", "act_then_report"], "note": "negation flip"},
{"text": "先に実行して、あとで変更点を報告する。", "lang": "ja", "expect": ["autonomy", "act_then_report"]},
{"text": "いちいち確認せずに進めて、終わったら報告して。", "lang": "ja", "expect": ["autonomy", "act_then_report"], "note": "negation flip"},
{"text": "先做，做完再汇报改了什么。", "lang": "zh", "expect": ["autonomy", "act_then_report"]},
{"text": "不用问我，直接动手，完事说一声。", "lang": "zh", "expect": ["autonomy", "act_then_report"], "note": "negation flip"},

{"text": "Use conventional commits: feat:, fix:, chore:.", "lang": "en", "expect": ["commit_style", "conventional"]},
{"text": "Every commit title needs a type prefix like feat or fix.", "lang": "en", "expect": ["commit_style", "conventional"]},
{"text": "커밋 제목은 feat:, fix: 같은 conventional prefix로 시작한다.", "lang": "ko", "expect": ["commit_style", "conventional"]},
{"text": "커밋 메시지 컨벤션은 conventional commits를 따른다.", "lang": "ko", "expect": ["commit_style", "conventional"]},
{"text": "コミットメッセージは feat: や fix: の prefix で始める。", "lang": "ja", "expect": ["commit_style", "conventional"]},
{"text": "コミットは Conventional Commits の規約に従う。", "lang": "ja", "expect": ["commit_style", "conventional"]},
{"text": "提交信息用 feat:/fix: 这样的前缀开头。", "lang": "zh", "expect": ["commit_style", "conventional"]},
{"text": "提交遵循 Conventional Commits 规范。", "lang": "zh", "expect": ["commit_style", "conventional"]},

{"text": "Commit titles should read as a plain sentence about the change.", "lang": "en", "expect": ["commit_style", "narrative"]},
{"text": "Skip the prefixes and write commit subjects as prose.", "lang": "en", "expect": ["commit_style", "narrative"]},
{"text": "커밋 제목은 변경 의도를 서술형 문장으로 적는다.", "lang": "ko", "expect": ["commit_style", "narrative"]},
{"text": "커밋 메시지는 접두사 없이 한 문장으로 쓴다.", "lang": "ko", "expect": ["commit_style", "narrative"]},
{"text": "コミットの件名は変更の意図を文章で書く。", "lang": "ja", "expect": ["commit_style", "narrative"]},
{"text": "コミットメッセージは prefix なしの一文にする。", "lang": "ja", "expect": ["commit_style", "narrative"]},
{"text": "提交标题写成一句说明改动意图的话。", "lang": "zh", "expect": ["commit_style", "narrative"]},
{"text": "提交信息不加前缀，用完整的句子写。", "lang": "zh", "expect": ["commit_style", "narrative"]},

{"text": "Never commit unless I explicitly ask.", "lang": "en", "expect": ["commit_style", "no_auto_commit"]},
{"text": "Don't run git commit on your own - leave the changes in the working tree.", "lang": "en", "expect": ["commit_style", "no_auto_commit"]},
{"text": "요청받지 않은 커밋은 만들지 않는다.", "lang": "ko", "expect": ["commit_style", "no_auto_commit"]},
{"text": "커밋은 하지 말고 변경사항을 워킹 트리에 남겨라.", "lang": "ko", "expect": ["commit_style", "no_auto_commit"]},
{"text": "頼まれていないコミットは作らない。", "lang": "ja", "expect": ["commit_style", "no_auto_commit"]},
{"text": "コミットはせず、変更はワーキングツリーに残すこと。", "lang": "ja", "expect": ["commit_style", "no_auto_commit"]},
{"text": "没让你提交就不要提交。", "lang": "zh", "expect": ["commit_style", "no_auto_commit"]},
{"text": "不要自己跑 git commit，改动留在工作区。", "lang": "zh", "expect": ["commit_style", "no_auto_commit"]},

{"text": "Write a failing test first, then make it pass.", "lang": "en", "expect": ["test_discipline", "test_first"]},
{"text": "Bug fixes start from a reproducing test.", "lang": "en", "expect": ["test_discipline", "test_first"]},
{"text": "버그 수정은 재현 테스트를 먼저 작성한 뒤 고친다.", "lang": "ko", "expect": ["test_discipline", "test_first"]},
{"text": "테스트를 먼저 쓰고 구현을 시작한다.", "lang": "ko", "expect": ["test_discipline", "test_first"]},
{"text": "先に失敗するテストを書いてから直す。", "lang": "ja", "expect": ["test_discipline", "test_first"]},
{"text": "テストを先に書いてから実装する。", "lang": "ja", "expect": ["test_discipline", "test_first"]},
{"text": "先写一个会失败的测试，再动手实现。", "lang": "zh", "expect": ["test_discipline", "test_first"]},
{"text": "修 bug 从复现测试开始。", "lang": "zh", "expect": ["test_discipline", "test_first"]},

{"text": "Add the tests in the same change as the implementation.", "lang": "en", "expect": ["test_discipline", "test_after"]},
{"text": "No change is done without tests.", "lang": "en", "expect": ["test_discipline", "test_after"]},
{"text": "구현한 직후 같은 변경 안에서 테스트를 추가한다.", "lang": "ko", "expect": ["test_discipline", "test_after"]},
{"text": "테스트 없는 변경은 완료로 보지 않는다.", "lang": "ko", "expect": ["test_discipline", "test_after"]},
{"text": "実装したらすぐ、同じ変更でテストを追加する。", "lang": "ja", "expect": ["test_discipline", "test_after"]},
{"text": "新しい機能には必ずテストを付ける。", "lang": "ja", "expect": ["test_discipline", "test_after"]},
{"text": "实现完在同一次改动里补上测试。", "lang": "zh", "expect": ["test_discipline", "test_after"]},
{"text": "新功能都要带测试。", "lang": "zh", "expect": ["test_discipline", "test_after"]},

{"text": "Write tests only when I ask for them.", "lang": "en", "expect": ["test_discipline", "on_request"]},
{"text": "Tests are optional unless requested.", "lang": "en", "expect": ["test_discipline", "on_request"]},
{"text": "테스트는 명시적으로 요청받았을 때만 작성한다.", "lang": "ko", "expect": ["test_discipline", "on_request"]},
{"text": "요청하지 않으면 테스트는 쓰지 않아도 된다.", "lang": "ko", "expect": ["test_discipline", "on_request"]},
{"text": "テストは頼まれたときだけ書く。", "lang": "ja", "expect": ["test_discipline", "on_request"]},
{"text": "指示がなければテストは書かなくてよい。", "lang": "ja", "expect": ["test_discipline", "on_request"]},
{"text": "只有明确要求时才写测试。", "lang": "zh", "expect": ["test_discipline", "on_request"]},
{"text": "没要求就不用写测试。", "lang": "zh", "expect": ["test_discipline", "on_request"]},

{"text": "Don't write comments that restate what the code does.", "lang": "en", "expect": ["comment_doc", "minimal"]},
{"text": "Keep comments to a minimum; the code should be self-documenting.", "lang": "en", "expect": ["comment_doc", "minimal"]},
{"text": "코드를 다시 설명하는 주석은 쓰지 않는다.", "lang": "ko", "expect": ["comment_doc", "minimal"]},
{"text": "불필요한 주석은 남기지 않는다.", "lang": "ko", "expect": ["comment_doc", "minimal"]},
{"text": "コードをなぞるだけのコメントは書かない。", "lang": "ja", "expect": ["comment_doc", "minimal"]},
{"text": "コメントは最小限にとどめる。", "lang": "ja", "expect": ["comment_doc", "minimal"]},
{"text": "不要写复述代码的注释。", "lang": "zh", "expect": ["comment_doc", "minimal"]},
{"text": "注释尽量少写，代码自己说明自己。", "lang": "zh", "expect": ["comment_doc", "minimal"]},

{"text": "Every public function needs a docstring; no inline comments.", "lang": "en", "expect": ["comment_doc", "docstring_only"]},
{"text": "Write JSDoc on exported functions and leave the bodies alone.", "lang": "en", "expect": ["comment_doc", "docstring_only"]},
{"text": "공개 함수에는 docstring을 쓰고 인라인 주석은 남기지 않는다.", "lang": "ko", "expect": ["comment_doc", "docstring_only"]},
{"text": "docstring만 쓰고 본문에는 주석을 달지 않는다.", "lang": "ko", "expect": ["comment_doc", "docstring_only"]},
{"text": "公開関数には docstring を書き、インラインコメントは残さない。", "lang": "ja", "expect": ["comment_doc", "docstring_only"]},
{"text": "エクスポートする関数には JSDoc を書く。", "lang": "ja", "expect": ["comment_doc", "docstring_only"]},
{"text": "公开函数都要写 docstring，不写行内注释。", "lang": "zh", "expect": ["comment_doc", "docstring_only"]},
{"text": "导出的函数写 JSDoc。", "lang": "zh", "expect": ["comment_doc", "docstring_only"]},

{"text": "Comment thoroughly - explain why, not just what.", "lang": "en", "expect": ["comment_doc", "thorough"]},
{"text": "Add inline comments wherever the logic isn't obvious.", "lang": "en", "expect": ["comment_doc", "thorough"]},
{"text": "복잡한 로직에는 상세한 주석을 남긴다.", "lang": "ko", "expect": ["comment_doc", "thorough"]},
{"text": "왜 이렇게 했는지까지 주석으로 충분히 설명한다.", "lang": "ko", "expect": ["comment_doc", "thorough"]},
{"text": "コメントは丁寧に書き、なぜそうしたのかまで残す。", "lang": "ja", "expect": ["comment_doc", "thorough"]},
{"text": "自明でないロジックには必ずインラインコメントを付ける。", "lang": "ja", "expect": ["comment_doc", "thorough"]},
{"text": "注释要写得详细，把为什么这么做也写清楚。", "lang": "zh", "expect": ["comment_doc", "thorough"]},
{"text": "不好懂的逻辑都要加注释。", "lang": "zh", "expect": ["comment_doc", "thorough"]},

{"text": "On the first error, stop and report the raw log.", "lang": "en", "expect": ["error_behavior", "stop_and_report"]},
{"text": "Never swallow an exception - show me the traceback verbatim.", "lang": "en", "expect": ["error_behavior", "stop_and_report"]},
{"text": "에러가 나면 즉시 멈추고 원문 로그를 그대로 보고한다.", "lang": "ko", "expect": ["error_behavior", "stop_and_report"]},
{"text": "예외를 삼키지 말고 실패한 출력을 그대로 보여줘.", "lang": "ko", "expect": ["error_behavior", "stop_and_report"]},
{"text": "エラーが出たらすぐ止めて、生のログをそのまま報告する。", "lang": "ja", "expect": ["error_behavior", "stop_and_report"]},
{"text": "例外を握りつぶさず、出力をそのまま見せること。", "lang": "ja", "expect": ["error_behavior", "stop_and_report"]},
{"text": "一出错就停下来，把原始日志原样贴出来。", "lang": "zh", "expect": ["error_behavior", "stop_and_report"]},
{"text": "不要吞掉异常，失败的输出原样给我看。", "lang": "zh", "expect": ["error_behavior", "stop_and_report"]},

{"text": "Retry a flaky command once, then stop and report.", "lang": "en", "expect": ["error_behavior", "retry_then_report"]},
{"text": "One retry is allowed; after that, hand it back to me.", "lang": "en", "expect": ["error_behavior", "retry_then_report"]},
{"text": "일시적으로 보이는 실패는 한 번만 재시도하고 그래도 안 되면 보고한다.", "lang": "ko", "expect": ["error_behavior", "retry_then_report"]},
{"text": "재시도는 한 번까지만 하고 멈춘다.", "lang": "ko", "expect": ["error_behavior", "retry_then_report"]},
{"text": "一時的に見える失敗は一度だけやり直し、だめなら報告する。", "lang": "ja", "expect": ["error_behavior", "retry_then_report"]},
{"text": "リトライは一回まで。それ以上は止めて報告する。", "lang": "ja", "expect": ["error_behavior", "retry_then_report"]},
{"text": "看着像偶发的失败只重试一次，再失败就停下汇报。", "lang": "zh", "expect": ["error_behavior", "retry_then_report"]},
{"text": "重试最多一次，之后停下来交给我。", "lang": "zh", "expect": ["error_behavior", "retry_then_report"]},

{"text": "Keep fixing until the tests pass, then report.", "lang": "en", "expect": ["error_behavior", "self_heal"]},
{"text": "Don't stop at the first failure - work through it until the build is green.", "lang": "en", "expect": ["error_behavior", "self_heal"]},
{"text": "테스트가 통과할 때까지 원인을 고쳐 진행한 뒤 결과를 보고한다.", "lang": "ko", "expect": ["error_behavior", "self_heal"]},
{"text": "빌드가 초록이 될 때까지 계속 고친다.", "lang": "ko", "expect": ["error_behavior", "self_heal"]},
{"text": "テストが通るまで原因を直し続けてから報告する。", "lang": "ja", "expect": ["error_behavior", "self_heal"]},
{"text": "ビルドが通るまで手を止めない。", "lang": "ja", "expect": ["error_behavior", "self_heal"]},
{"text": "一直修到测试通过，再汇报结果。", "lang": "zh", "expect": ["error_behavior", "self_heal"]},
{"text": "构建挂了就接着改，直到全绿。", "lang": "zh", "expect": ["error_behavior", "self_heal"]},

{"text": "Only change what was asked; nothing else.", "lang": "en", "expect": ["scope_adherence", "strict"]},
{"text": "Never touch unrelated files - report the defect instead of fixing it.", "lang": "en", "expect": ["scope_adherence", "strict"]},
{"text": "요청받은 범위 밖의 파일은 수정하지 않는다.", "lang": "ko", "expect": ["scope_adherence", "strict"]},
{"text": "관련 없는 코드는 건드리지 말고 발견하면 보고만 해라.", "lang": "ko", "expect": ["scope_adherence", "strict"]},
{"text": "頼まれた範囲の外のファイルには触らない。", "lang": "ja", "expect": ["scope_adherence", "strict"]},
{"text": "関係ないコードは直さず、見つけたら報告だけにする。", "lang": "ja", "expect": ["scope_adherence", "strict"]},
{"text": "只改要求的部分，别的不要动。", "lang": "zh", "expect": ["scope_adherence", "strict"]},
{"text": "无关的文件不要碰，发现问题只汇报。", "lang": "zh", "expect": ["scope_adherence", "strict"]},

{"text": "Fixing a closely related bug in the same change is fine - just say so.", "lang": "en", "expect": ["scope_adherence", "adjacent_fix_ok"]},
{"text": "You may clean the code right next to your change; anything further, report only.", "lang": "en", "expect": ["scope_adherence", "adjacent_fix_ok"]},
{"text": "바로 맞닿은 결함까지는 같은 변경에서 고쳐도 된다.", "lang": "ko", "expect": ["scope_adherence", "adjacent_fix_ok"]},
{"text": "인접한 사소한 수정은 함께 처리하고 보고에 적는다.", "lang": "ko", "expect": ["scope_adherence", "adjacent_fix_ok"]},
{"text": "すぐ隣にある不具合までは同じ変更で直してよい。", "lang": "ja", "expect": ["scope_adherence", "adjacent_fix_ok"]},
{"text": "隣接する範囲の小さな修正は一緒にやってよい。", "lang": "ja", "expect": ["scope_adherence", "adjacent_fix_ok"]},
{"text": "紧挨着改动的小问题可以顺手一起修。", "lang": "zh", "expect": ["scope_adherence", "adjacent_fix_ok"]},
{"text": "相邻的小毛病可以在同一次改动里顺手修掉。", "lang": "zh", "expect": ["scope_adherence", "adjacent_fix_ok"]},

{"text": "Refactor as you go and fold the cleanup into the same change.", "lang": "en", "expect": ["scope_adherence", "proactive"]},
{"text": "Proactively fix the things you notice while working.", "lang": "en", "expect": ["scope_adherence", "proactive"]},
{"text": "작업하다 눈에 띈 개선은 선제적으로 같이 정리한다.", "lang": "ko", "expect": ["scope_adherence", "proactive"]},
{"text": "지나가다 본 코드도 그때그때 리팩터링한다.", "lang": "ko", "expect": ["scope_adherence", "proactive"]},
{"text": "作業のついでに気づいた改善もリファクタリングして入れる。", "lang": "ja", "expect": ["scope_adherence", "proactive"]},
{"text": "気づいた問題は先回りして直しておく。", "lang": "ja", "expect": ["scope_adherence", "proactive"]},
{"text": "顺手重构碰到的代码，把整理一起做掉。", "lang": "zh", "expect": ["scope_adherence", "proactive"]},
{"text": "发现的改进点主动一起改掉。", "lang": "zh", "expect": ["scope_adherence", "proactive"]},

{"text": "Run the full test suite before you call anything done.", "lang": "en", "expect": ["verification", "always_run"]},
{"text": "Everything must pass before you commit.", "lang": "en", "expect": ["verification", "always_run"]},
{"text": "완료를 선언하기 전에 테스트와 빌드를 실제로 돌려 통과를 확인한다.", "lang": "ko", "expect": ["verification", "always_run"]},
{"text": "커밋 전에 반드시 전체 테스트를 돌린다.", "lang": "ko", "expect": ["verification", "always_run"]},
{"text": "完了を宣言する前にテストとビルドを実際に走らせる。", "lang": "ja", "expect": ["verification", "always_run"]},
{"text": "コミットする前に必ずテストを通す。", "lang": "ja", "expect": ["verification", "always_run"]},
{"text": "宣布完成前先把测试和构建都跑一遍。", "lang": "zh", "expect": ["verification", "always_run"]},
{"text": "提交之前测试必须全部通过。", "lang": "zh", "expect": ["verification", "always_run"]},

{"text": "Run the whole suite only for risky changes; otherwise just the touched tests.", "lang": "en", "expect": ["verification", "on_risky"]},
{"text": "For small edits the related tests are enough.", "lang": "en", "expect": ["verification", "on_risky"]},
{"text": "위험한 변경일 때만 전체 검증을 돌린다.", "lang": "ko", "expect": ["verification", "on_risky"]},
{"text": "작은 수정은 해당 테스트만 확인하면 된다.", "lang": "ko", "expect": ["verification", "on_risky"]},
{"text": "リスクの高い変更のときだけ全体検証を走らせる。", "lang": "ja", "expect": ["verification", "on_risky"]},
{"text": "小さな修正なら関連するテストだけでいい。", "lang": "ja", "expect": ["verification", "on_risky"]},
{"text": "只有风险高的改动才跑完整验证。", "lang": "zh", "expect": ["verification", "on_risky"]},
{"text": "小改动只跑相关的测试就行。", "lang": "zh", "expect": ["verification", "on_risky"]},

{"text": "A careful re-read and a type check are enough to call it done.", "lang": "en", "expect": ["verification", "trust_static"]},
{"text": "Static checks are sufficient here.", "lang": "en", "expect": ["verification", "trust_static"]},
{"text": "타입 체크로 충분하면 그대로 완료를 선언한다.", "lang": "ko", "expect": ["verification", "trust_static"]},
{"text": "정적 확인만으로 끝내도 된다.", "lang": "ko", "expect": ["verification", "trust_static"]},
{"text": "型チェックと読み直しで十分なら、そのまま完了としてよい。", "lang": "ja", "expect": ["verification", "trust_static"]},
{"text": "静的な確認だけで完了を宣言してよい。", "lang": "ja", "expect": ["verification", "trust_static"]},
{"text": "过一遍类型检查就够了。", "lang": "zh", "expect": ["verification", "trust_static"]},
{"text": "静态检查够用的话，直接宣布完成。", "lang": "zh", "expect": ["verification", "trust_static"]},

{"text": "Prefer the standard library over new packages.", "lang": "en", "expect": ["dependency_policy", "prefer_existing"]},
{"text": "Avoid adding new dependencies; use what is already in package.json.", "lang": "en", "expect": ["dependency_policy", "prefer_existing"]},
{"text": "새 패키지보다 기존 의존성과 표준 라이브러리를 우선한다.", "lang": "ko", "expect": ["dependency_policy", "prefer_existing"]},
{"text": "새 의존성은 되도록 추가하지 않는다.", "lang": "ko", "expect": ["dependency_policy", "prefer_existing"]},
{"text": "新しいパッケージより既存の依存と標準ライブラリを優先する。", "lang": "ja", "expect": ["dependency_policy", "prefer_existing"]},
{"text": "新しい依存はできるだけ増やさない。", "lang": "ja", "expect": ["dependency_policy", "prefer_existing"]},
{"text": "优先用已有依赖和标准库。", "lang": "zh", "expect": ["dependency_policy", "prefer_existing"]},
{"text": "尽量不要引入新的依赖。", "lang": "zh", "expect": ["dependency_policy", "prefer_existing"]},

{"text": "Ask before adding any new dependency.", "lang": "en", "expect": ["dependency_policy", "ask_first"]},
{"text": "New packages need my approval first.", "lang": "en", "expect": ["dependency_policy", "ask_first"]},
{"text": "새 의존성은 추가하기 전에 반드시 확인을 받는다.", "lang": "ko", "expect": ["dependency_policy", "ask_first"]},
{"text": "패키지를 설치하기 전에 먼저 물어봐라.", "lang": "ko", "expect": ["dependency_policy", "ask_first"]},
{"text": "新しい依存を追加する前に必ず確認を取る。", "lang": "ja", "expect": ["dependency_policy", "ask_first"]},
{"text": "パッケージを入れる前に相談すること。", "lang": "ja", "expect": ["dependency_policy", "ask_first"]},
{"text": "加新依赖之前先问我。", "lang": "zh", "expect": ["dependency_policy", "ask_first"]},
{"text": "装新包要先经过我同意。", "lang": "zh", "expect": ["dependency_policy", "ask_first"]},

{"text": "Add whatever dependencies you need and list them in the report.", "lang": "en", "expect": ["dependency_policy", "free"]},
{"text": "No need to ask before installing a package.", "lang": "en", "expect": ["dependency_policy", "free"], "note": "negation flip"},
{"text": "필요한 의존성은 바로 추가하고 목록만 남겨라.", "lang": "ko", "expect": ["dependency_policy", "free"]},
{"text": "패키지는 묻지 말고 그냥 설치해라.", "lang": "ko", "expect": ["dependency_policy", "free"], "note": "negation flip"},
{"text": "必要な依存はその場で追加してよい。", "lang": "ja", "expect": ["dependency_policy", "free"]},
{"text": "パッケージは確認なしで入れてかまわない。", "lang": "ja", "expect": ["dependency_policy", "free"], "note": "negation flip"},
{"text": "需要什么依赖直接装。", "lang": "zh", "expect": ["dependency_policy", "free"]},
{"text": "装包不用问我，装完列一下就行。", "lang": "zh", "expect": ["dependency_policy", "free"], "note": "negation flip"},

{"text": "don't ask me to write the tests for you", "lang": "en", "expect": null, "note": "wrong actor"},
{"text": "commit messages in English", "lang": "en", "expect": null},
{"text": "avoid dependency injection", "lang": "en", "expect": null},
{"text": "The test suite lives in tests/ and takes about 40 seconds.", "lang": "en", "expect": null},
{"text": "This repo uses a conventional folder layout.", "lang": "en", "expect": null},
{"text": "Add a comment on the pull request when you open it.", "lang": "en", "expect": null},
{"text": "The build runs on Node 20.", "lang": "en", "expect": null},
{"text": "Ask the design team for the latest mockups.", "lang": "en", "expect": null},
{"text": "Free tier accounts are limited to five seats.", "lang": "en", "expect": null},
{"text": "Report bugs in the issue tracker, not in Slack.", "lang": "en", "expect": null},
{"text": "Run `npm start` to boot the dev server.", "lang": "en", "expect": null},
{"text": "Error messages should be written in plain English.", "lang": "en", "expect": null},
{"text": "The scope of this project is intentionally small.", "lang": "en", "expect": null},
{"text": "Use the existing design tokens for spacing.", "lang": "en", "expect": null},
{"text": "Keep the diff small and readable.", "lang": "en", "expect": null},
{"text": "Stop the dev server with Ctrl-C.", "lang": "en", "expect": null},
{"text": "Retry logic already lives in the HTTP client.", "lang": "en", "expect": null},
{"text": "Tests run on Python 3.12.", "lang": "en", "expect": null},
{"text": "Document the API in docs/api.md.", "lang": "en", "expect": null},
{"text": "We prefer async/await over callbacks.", "lang": "en", "expect": null},
{"text": "The plan document lives in docs/plan.md.", "lang": "en", "expect": null},
{"text": "테스트 코드는 tests/ 아래에 있다.", "lang": "ko", "expect": null},
{"text": "커밋 메시지는 영어로 쓴다.", "lang": "ko", "expect": null},
{"text": "의존성 주입은 피한다.", "lang": "ko", "expect": null},
{"text": "PR 설명에 스크린샷을 첨부한다.", "lang": "ko", "expect": null},
{"text": "빌드는 GitHub Actions에서 돈다.", "lang": "ko", "expect": null},
{"text": "에러 메시지는 한국어로 작성한다.", "lang": "ko", "expect": null},
{"text": "기존 디자인 토큰을 그대로 쓴다.", "lang": "ko", "expect": null},
{"text": "주석은 한국어로 써도 된다.", "lang": "ko", "expect": null},
{"text": "이 저장소의 범위는 CLI 하나로 제한한다.", "lang": "ko", "expect": null},
{"text": "재시도 로직은 이미 클라이언트에 들어 있다.", "lang": "ko", "expect": null},
{"text": "테스트를 대신 써 달라고 요청하지 마라.", "lang": "ko", "expect": null, "note": "wrong actor"},
{"text": "패키지 매니저는 pnpm을 쓴다.", "lang": "ko", "expect": null},
{"text": "문서는 docs/ 아래에 둔다.", "lang": "ko", "expect": null},
{"text": "로그는 logger로 남긴다.", "lang": "ko", "expect": null},
{"text": "계획 문서는 docs/plan.md에 있다.", "lang": "ko", "expect": null},
{"text": "テストは tests/ 以下にある。", "lang": "ja", "expect": null},
{"text": "コミットメッセージは英語で書く。", "lang": "ja", "expect": null},
{"text": "依存性注入は使わない。", "lang": "ja", "expect": null},
{"text": "ビルドは GitHub Actions で走る。", "lang": "ja", "expect": null},
{"text": "エラーメッセージは日本語で書く。", "lang": "ja", "expect": null},
{"text": "既存のデザイントークンをそのまま使う。", "lang": "ja", "expect": null},
{"text": "ドキュメントは docs/ に置く。", "lang": "ja", "expect": null},
{"text": "ログは logger で出す。", "lang": "ja", "expect": null},
{"text": "测试放在 tests/ 目录下。", "lang": "zh", "expect": null},
{"text": "提交信息用英文写。", "lang": "zh", "expect": null},
{"text": "不要用依赖注入。", "lang": "zh", "expect": null},
{"text": "构建跑在 GitHub Actions 上。", "lang": "zh", "expect": null},
{"text": "错误信息用中文写。", "lang": "zh", "expect": null},
{"text": "沿用现有的设计 token。", "lang": "zh", "expect": null},
{"text": "文档放在 docs/ 下面。", "lang": "zh", "expect": null},
{"text": "日志用 logger 打。", "lang": "zh", "expect": null},

{"text": "Run the plan by me before touching anything.", "lang": "en", "expect": ["autonomy", "ask_first"], "note": "paraphrase"},
{"text": "무엇을 할지 먼저 알려주고 승인이 나면 착수해라.", "lang": "ko", "expect": ["autonomy", "ask_first"], "note": "paraphrase"},
{"text": "自分で判断せず、まず相談してから動く。", "lang": "ja", "expect": ["autonomy", "ask_first"], "note": "paraphrase"},
{"text": "做之前先跟我确认一下。", "lang": "zh", "expect": ["autonomy", "ask_first"], "note": "paraphrase"},
{"text": "自己判断で進めて、終わったら結果だけ見せて。", "lang": "ja", "expect": ["autonomy", "act_then_report"], "note": "paraphrase"},
{"text": "Follow the angular commit convention.", "lang": "en", "expect": ["commit_style", "conventional"], "note": "paraphrase"},
{"text": "git commit は絶対に自分で実行しないこと。", "lang": "ja", "expect": ["commit_style", "no_auto_commit"], "note": "paraphrase"},
{"text": "提交信息用一句人话说清楚做了什么。", "lang": "zh", "expect": ["commit_style", "narrative"], "note": "paraphrase"},
{"text": "기능을 만들면 테스트도 같이 올린다.", "lang": "ko", "expect": ["test_discipline", "test_after"], "note": "paraphrase"},
{"text": "Skip the tests unless I ask.", "lang": "en", "expect": ["test_discipline", "on_request"], "note": "paraphrase"},
{"text": "버그는 실패하는 테스트부터 만들고 잡는다.", "lang": "ko", "expect": ["test_discipline", "test_first"], "note": "paraphrase"},
{"text": "代码里少放注释。", "lang": "zh", "expect": ["comment_doc", "minimal"], "note": "paraphrase"},
{"text": "Docstrings everywhere, comments nowhere.", "lang": "en", "expect": ["comment_doc", "docstring_only"], "note": "paraphrase"},
{"text": "If a command fails, hand me the output and wait.", "lang": "en", "expect": ["error_behavior", "stop_and_report"], "note": "paraphrase"},
{"text": "エラーはそのままの形で見せて、勝手に要約しない。", "lang": "ja", "expect": ["error_behavior", "stop_and_report"], "note": "paraphrase"},
{"text": "如果失败了先重试一遍，还不行就报给我。", "lang": "zh", "expect": ["error_behavior", "retry_then_report"], "note": "paraphrase"},
{"text": "指示された以外のところは直さない。", "lang": "ja", "expect": ["scope_adherence", "strict"], "note": "paraphrase"},
{"text": "周りの小さな不具合も一緒に直してよい。", "lang": "ja", "expect": ["scope_adherence", "adjacent_fix_ok"], "note": "paraphrase"},
{"text": "테스트 전부 돌려보고 통과한 걸 확인한 다음에 끝내라.", "lang": "ko", "expect": ["verification", "always_run"], "note": "paraphrase"},
{"text": "改完自己跑一遍测试再说完成。", "lang": "zh", "expect": ["verification", "always_run"], "note": "paraphrase"},
{"text": "Only run everything when the change is scary.", "lang": "en", "expect": ["verification", "on_risky"], "note": "paraphrase"},
{"text": "能用标准库就别装第三方。", "lang": "zh", "expect": ["dependency_policy", "prefer_existing"], "note": "paraphrase"},
{"text": "Ask the user for the API key on first run.", "lang": "en", "expect": null},
{"text": "이 문서의 범위는 프런트엔드까지다.", "lang": "ko", "expect": null},
{"text": "테스트는 pytest로 돌린다.", "lang": "ko", "expect": null},
{"text": "リトライ回数は設定ファイルで変える。", "lang": "ja", "expect": null},
{"text": "重构计划见 docs/refactor.md。", "lang": "zh", "expect": null},
{"text": "Comments in the config file explain each key.", "lang": "en", "expect": null}
]
